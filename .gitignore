# Ignore ISO disk images
*.iso

# Ignore GIMP files
*.xcf

# Config files — filled values are private and must NEVER be committed.
# Only *.template files (with empty values) are committed.
nixos/config.nix
nixos/config-vps.nix

# Archived draft configs — contain identifying data
00-hallucinations

# Secrets and sops config — filled or encrypted files must NEVER be committed.
# Only *.template files (with empty values) are committed.
.sops.yaml
.sops-vps.yaml
secrets.plain
secrets-vps.plain
secrets.yaml
secrets-vps.yaml
secrets.env

# NixOS — machine-specific and build artifacts
nixos/hardware-configuration.nix
nixos/hardware-configuration-vps.nix
nixos/result
nixos/result-*
.direnv/

# Claude Code settings
.claude

# Graphify — knowledge graph outputs (keep only the rendered artifacts)
base_de_conocimientos/graphify/*
!base_de_conocimientos/graphify/graph.html
!base_de_conocimientos/graphify/graph.json

# Knowledge base - content in development
base_de_conocimientos/lenguaje_común/

base_de_conocimientos/midu/arquitectura/

base_de_conocimientos/subjetividades/
base_de_conocimientos/alfabeto.digital.md

# Notas de desarrollo — tareas pendientes locales
base_de_conocimientos/notas_de_desarrollo.md